set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE75F23C8
set_global_assignment -name TOP_LEVEL_ENTITY hamming_fsk_stream_board
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY advanced_output
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE hamming_fsk_board.sdc

# V2 course pinout, checked against the SimpleCase project.
set_location_assignment PIN_T2 -to sys_clk
set_location_assignment PIN_T22 -to reset
set_location_assignment PIN_H21 -to led_1[0]
set_location_assignment PIN_H20 -to led_1[1]
set_location_assignment PIN_F21 -to led_1[2]
set_location_assignment PIN_G18 -to led_1[3]
set_location_assignment PIN_H19 -to led_1[4]
set_location_assignment PIN_F19 -to led_1[5]
set_location_assignment PIN_D19 -to led_1[6]
set_location_assignment PIN_F17 -to led_1[7]
set_location_assignment PIN_L22 -to led_2[0]
set_location_assignment PIN_L21 -to led_2[1]
set_location_assignment PIN_F14 -to led_2[2]
set_location_assignment PIN_K21 -to led_2[3]
set_location_assignment PIN_J22 -to led_2[4]
set_location_assignment PIN_J21 -to led_2[5]
set_location_assignment PIN_F13 -to led_2[6]
set_location_assignment PIN_H22 -to led_2[7]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sys_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_1[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_2[*]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name EDA_SIMULATION_TOOL "QuestaSim (Verilog)"
set_global_assignment -name EDA_NETLIST_WRITER_OUTPUT_DIR board_verify_tmp -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation


# Continuous sampled link, stages 1-3. Previous implementation is in Git baseline f28a1c8.
set_global_assignment -name VHDL_FILE comm_stream_pkg.vhd
set_global_assignment -name VHDL_FILE comm_packet_tx.vhd
set_global_assignment -name VHDL_FILE comm_sample_rx.vhd
set_global_assignment -name VHDL_FILE comm_bit_channel.vhd
set_global_assignment -name VHDL_FILE comm_packet_rx.vhd
set_global_assignment -name VHDL_FILE hamming_fsk_stream.vhd
set_global_assignment -name VHDL_FILE hamming_fsk_stream_board.vhd
